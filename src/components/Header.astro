---
const navigation = [
    { label: "درباره من", href: "#about" },
    { label: "تجربه", href: "#experience" },
    { label: "پروژه‌ها", href: "#projects" },
    { label: "مهارت‌ها", href: "#skills" },
    { label: "تحصیلات", href: "#education" },
    { label: "تماس", href: "#contact" },
];
---

<header class="site-header">
    <div class="header-shell">
        <a class="brand" href="/" aria-label="صفحه اصلی">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
            </span>

            <span class="brand-text">
                <span class="brand-name">علی طغرلی</span>
                <span class="brand-role">Full-Stack Engineer</span>
            </span>
        </a>

        <nav class="desktop-nav" aria-label="ناوبری اصلی">
            {
                navigation.map((item) => (
                    <a class="nav-link" href={item.href}>
                        <span>{item.label}</span>
                    </a>
                ))
            }
        </nav>

        <div class="header-actions">
            <a class="contact-button" href="#contact">
                <span>ارتباط</span>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path
                        d="M3 8h9M8 4l4 4-4 4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </a>

            <button
                class="mobile-menu-button"
                type="button"
                aria-label="باز کردن منو"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <span></span>
                <span></span>
            </button>
        </div>
    </div>

    <div class="header-glow" aria-hidden="true"></div>

    <nav id="mobile-menu" class="mobile-menu" aria-label="ناوبری موبایل">
        {
            navigation.map((item) => (
                <a class="mobile-nav-link" href={item.href}>
                    <span>{item.label}</span>

                    <svg
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path
                            d="M3 8h9M8 4l4 4-4 4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </a>
            ))
        }
    </nav>
</header>

<script>
    const header = document.querySelector(".site-header");
    const menuButton = document.querySelector(".mobile-menu-button");
    const mobileMenu = document.querySelector(".mobile-menu");

    if (header && menuButton && mobileMenu) {
        const updateHeader = () => {
            header.classList.toggle("is-scrolled", window.scrollY > 12);
        };

        window.addEventListener("scroll", updateHeader, { passive: true });
        updateHeader();

        menuButton.addEventListener("click", () => {
            const isOpen = header.classList.toggle("menu-open");

            menuButton.setAttribute("aria-expanded", String(isOpen));
            menuButton.setAttribute(
                "aria-label",
                isOpen ? "بستن منو" : "باز کردن منو",
            );
        });

        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                header.classList.remove("menu-open");
                menuButton.setAttribute("aria-expanded", "false");
                menuButton.setAttribute("aria-label", "باز کردن منو");
            });
        });
    }
</script>

<style>
    .site-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        z-index: 100;

        padding: 1rem 0;

        transition:
            padding 250ms ease,
            background-color 250ms ease;
    }

    .header-shell {
        position: relative;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;

        width: min(
            100% - (var(--container-padding) * 2),
            var(--container-width)
        );

        min-height: 4rem;
        margin-inline: auto;
        padding: 0.625rem 0.75rem;

        background: rgba(8, 11, 10, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.075);
        border-radius: 1rem;

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        box-shadow:
            0 10px 40px rgba(0, 0, 0, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.035);

        transition:
            background-color 250ms ease,
            border-color 250ms ease,
            box-shadow 250ms ease;
    }

    .site-header.is-scrolled {
        padding-top: 0.625rem;
    }

    .site-header.is-scrolled .header-shell {
        background: rgba(8, 11, 10, 0.88);
        border-color: rgba(255, 255, 255, 0.11);
        box-shadow:
            0 14px 45px rgba(0, 0, 0, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;

        flex-shrink: 0;
    }

    .brand-mark {
        position: relative;

        display: grid;
        place-items: center;

        width: 2.5rem;
        height: 2.5rem;

        overflow: hidden;

        background: linear-gradient(
            135deg,
            rgba(94, 230, 168, 0.16),
            rgba(94, 230, 168, 0.025)
        );

        border: 1px solid rgba(94, 230, 168, 0.22);
        border-radius: 0.75rem;

        box-shadow:
            inset 0 0 20px rgba(94, 230, 168, 0.04),
            0 0 20px rgba(94, 230, 168, 0.03);

        transition:
            transform 250ms ease,
            border-color 250ms ease,
            box-shadow 250ms ease;
    }

    .brand-mark::before {
        content: "";

        position: absolute;
        inset: -40%;

        background: linear-gradient(
            135deg,
            transparent 35%,
            rgba(94, 230, 168, 0.3),
            transparent 65%
        );

        transform: translateX(-70%) rotate(25deg);
        transition: transform 500ms ease;
    }

    .brand-mark span {
        position: relative;

        width: 0.65rem;
        height: 0.65rem;

        background: var(--color-accent);
        border-radius: 50%;

        box-shadow:
            0 0 0 5px rgba(94, 230, 168, 0.08),
            0 0 18px rgba(94, 230, 168, 0.45);
    }

    .brand:hover .brand-mark {
        transform: translateY(-1px);
        border-color: rgba(94, 230, 168, 0.45);
        box-shadow:
            inset 0 0 20px rgba(94, 230, 168, 0.07),
            0 0 25px rgba(94, 230, 168, 0.08);
    }

    .brand:hover .brand-mark::before {
        transform: translateX(70%) rotate(25deg);
    }

    .brand-text {
        display: flex;
        flex-direction: column;
        gap: 0.05rem;
    }

    .brand-name {
        color: var(--color-text);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.3;
    }

    .brand-role {
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        direction: ltr;
        text-align: right;
    }

    .desktop-nav {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .nav-link {
        position: relative;

        display: inline-flex;
        align-items: center;

        padding: 0.65rem 0.75rem;

        color: var(--color-text-muted);

        font-size: 0.78rem;
        font-weight: 500;

        transition:
            color 180ms ease,
            background-color 180ms ease;
    }

    .nav-link::after {
        content: "";

        position: absolute;
        right: 0.75rem;
        bottom: 0.35rem;
        left: 0.75rem;

        height: 1px;

        background: var(--color-accent);

        transform: scaleX(0);
        transform-origin: center;

        transition: transform 180ms ease;
    }

    .nav-link:hover {
        color: var(--color-text);
    }

    .nav-link:hover::after {
        transform: scaleX(1);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .contact-button {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;

        min-height: 2.5rem;
        padding: 0.55rem 0.8rem 0.55rem 0.9rem;

        background: var(--color-accent);
        color: var(--color-bg);

        border-radius: 0.7rem;

        font-size: 0.75rem;
        font-weight: 600;

        transition:
            transform 180ms ease,
            background-color 180ms ease,
            box-shadow 180ms ease;
    }

    .contact-button svg {
        width: 1rem;
        height: 1rem;

        transition: transform 180ms ease;
    }

    .contact-button:hover {
        background: var(--color-accent-strong);
        transform: translateY(-1px);
        box-shadow: 0 7px 25px rgba(94, 230, 168, 0.12);
    }

    .contact-button:hover svg {
        transform: translateX(-2px);
    }

    .mobile-menu-button {
        display: none;

        width: 2.5rem;
        height: 2.5rem;
        padding: 0;

        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 0.7rem;

        transition:
            background-color 180ms ease,
            border-color 180ms ease;
    }

    .mobile-menu-button span {
        display: block;

        width: 1rem;
        height: 1px;
        margin-inline: auto;

        background: var(--color-text);

        transition:
            transform 200ms ease,
            opacity 200ms ease;
    }

    .mobile-menu-button span + span {
        margin-top: 0.3rem;
    }

    .mobile-menu-button:hover {
        background: var(--color-accent-soft);
        border-color: rgba(94, 230, 168, 0.3);
    }

    .menu-open .mobile-menu-button span:first-child {
        transform: translateY(2px) rotate(45deg);
    }

    .menu-open .mobile-menu-button span:last-child {
        transform: translateY(-2px) rotate(-45deg);
    }

    .header-glow {
        position: absolute;
        top: -10rem;
        left: 50%;

        width: 24rem;
        height: 16rem;

        pointer-events: none;

        background: radial-gradient(
            circle,
            rgba(94, 230, 168, 0.045),
            transparent 70%
        );

        transform: translateX(-50%);
    }

    .mobile-menu {
        display: none;
    }

    @media (max-width: 960px) {
        .desktop-nav {
            display: none;
        }

        .mobile-menu-button {
            display: block;
        }

        .header-actions {
            margin-inline-start: auto;
        }

        .mobile-menu {
            position: absolute;
            top: calc(100% + 0.5rem);
            right: var(--container-padding);
            left: var(--container-padding);

            display: flex;
            flex-direction: column;

            padding: 0.5rem;

            background: rgba(13, 18, 16, 0.96);
            border: 1px solid var(--color-border);
            border-radius: 1rem;

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            box-shadow: var(--shadow-md);

            opacity: 0;
            visibility: hidden;
            transform: translateY(-0.5rem);

            transition:
                opacity 180ms ease,
                visibility 180ms ease,
                transform 180ms ease;
        }

        .menu-open .mobile-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .mobile-nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0.9rem 1rem;

            color: var(--color-text-secondary);

            border-radius: 0.7rem;

            font-size: 0.85rem;

            transition:
                color 180ms ease,
                background-color 180ms ease;
        }

        .mobile-nav-link svg {
            width: 1rem;
            height: 1rem;

            opacity: 0.5;

            transition: transform 180ms ease;
        }

        .mobile-nav-link:hover {
            background: var(--color-accent-soft);
            color: var(--color-text);
        }

        .mobile-nav-link:hover svg {
            transform: translateX(-2px);
        }
    }

    @media (max-width: 520px) {
        .site-header {
            padding-top: 0.75rem;
        }

        .header-shell {
            min-height: 3.75rem;
            padding: 0.5rem;
        }

        .brand-role {
            display: none;
        }

        .contact-button span {
            display: none;
        }

        .contact-button {
            width: 2.5rem;
            padding: 0;
        }

        .contact-button svg {
            margin: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .brand-mark,
        .brand-mark::before,
        .nav-link::after,
        .contact-button,
        .contact-button svg,
        .mobile-menu-button span,
        .mobile-menu,
        .mobile-nav-link svg {
            transition: none;
        }
    }
</style>
