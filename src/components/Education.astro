---
const education = {
    degree: "کارشناسی مهندسی مکانیک",
    university: "دانشگاه جیرفت",
    period: "۱۳۹۳ — ۱۳۹۸",
};
---

<section class="education section" id="education">
    <div class="container">
        <div class="education-header">
            <div class="section-kicker">
                <span>04</span>
                <span>تحصیلات</span>
            </div>

            <span class="education-label">EDUCATION</span>
        </div>

        <div class="education-card">
            <div class="education-index">
                <span>01</span>
            </div>

            <div class="education-main">
                <span class="education-period">{education.period}</span>

                <h2>{education.degree}</h2>

                <p>{education.university}</p>
            </div>

            <div class="education-status">
                <span class="status-dot"></span>
                <span>مدرک اخذ شده</span>
            </div>

            <div class="education-decoration" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</section>

<style>
    .education {
        position: relative;

        padding-top: 7rem;
        padding-bottom: 7rem;
    }

    .education-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        margin-bottom: 2rem;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;

        color: var(--color-accent);

        font-size: 0.7rem;
        font-weight: 600;
    }

    .section-kicker > span:first-child {
        display: grid;
        place-items: center;

        width: 1.7rem;
        height: 1.7rem;

        background: var(--color-accent-soft);
        border: 1px solid rgba(94, 230, 168, 0.12);
        border-radius: 0.45rem;

        font-family: monospace;
        font-size: 0.6rem;
    }

    .education-label {
        color: var(--color-text-muted);

        font-family: monospace;
        font-size: 0.5rem;
        letter-spacing: 0.08em;
    }

    .education-card {
        position: relative;

        display: grid;
        grid-template-columns: 4rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 2rem;

        overflow: hidden;

        padding: 2.5rem 2rem;

        background: linear-gradient(
            110deg,
            rgba(255, 255, 255, 0.018),
            rgba(255, 255, 255, 0.006)
        );

        border: 1px solid var(--color-border);
        border-radius: 0.85rem;

        transition:
            border-color 300ms ease,
            transform 300ms ease,
            background-color 300ms ease;
    }

    .education-card::before {
        content: "";

        position: absolute;
        inset: 0;

        background: radial-gradient(
            circle at 80% 50%,
            rgba(94, 230, 168, 0.055),
            transparent 35%
        );

        opacity: 0;

        transition: opacity 400ms ease;

        pointer-events: none;
    }

    .education-card:hover {
        background-color: rgba(255, 255, 255, 0.012);

        border-color: rgba(94, 230, 168, 0.14);

        transform: translateY(-2px);
    }

    .education-card:hover::before {
        opacity: 1;
    }

    .education-index {
        position: relative;
        z-index: 1;

        display: grid;
        place-items: center;

        width: 3rem;
        height: 3rem;

        background: var(--color-accent-soft);
        border: 1px solid rgba(94, 230, 168, 0.1);
        border-radius: 0.6rem;

        color: var(--color-accent);

        font-family: monospace;
        font-size: 0.55rem;
    }

    .education-main {
        position: relative;
        z-index: 1;
    }

    .education-period {
        display: block;

        margin-bottom: 0.65rem;

        color: var(--color-accent);

        font-family: monospace;
        font-size: 0.55rem;
    }

    .education-main h2 {
        margin: 0;

        color: var(--color-text-primary);

        font-size: clamp(1.15rem, 2vw, 1.5rem);
        font-weight: 600;
        letter-spacing: -0.025em;
    }

    .education-main p {
        margin: 0.5rem 0 0;

        color: var(--color-text-muted);

        font-size: 0.7rem;
    }

    .education-status {
        position: relative;
        z-index: 1;

        display: inline-flex;
        align-items: center;
        gap: 0.55rem;

        color: var(--color-text-muted);

        font-family: monospace;
        font-size: 0.5rem;
        white-space: nowrap;
    }

    .status-dot {
        width: 0.4rem;
        height: 0.4rem;

        background: var(--color-accent);
        border-radius: 50%;

        box-shadow: 0 0 0 4px var(--color-accent-soft);
    }

    .education-decoration {
        position: absolute;
        right: -1rem;
        bottom: -1rem;

        display: flex;
        gap: 0.3rem;

        transform: rotate(-35deg);
        opacity: 0.5;
    }

    .education-decoration span {
        width: 0.3rem;
        height: 4rem;

        background: var(--color-border-strong);
        border-radius: 999px;
    }

    .education-decoration span:nth-child(2) {
        height: 6rem;

        background: rgba(94, 230, 168, 0.12);
    }

    .education-decoration span:nth-child(3) {
        height: 3rem;
    }

    @media (max-width: 700px) {
        .education {
            padding-top: 5rem;
            padding-bottom: 5rem;
        }

        .education-card {
            grid-template-columns: 3rem minmax(0, 1fr);
            gap: 1rem;

            padding: 1.5rem;
        }

        .education-index {
            width: 2.5rem;
            height: 2.5rem;
        }

        .education-status {
            grid-column: 2;

            margin-top: 0.5rem;
        }

        .education-label {
            display: none;
        }
    }
</style>
