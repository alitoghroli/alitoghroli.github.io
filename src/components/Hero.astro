---
const technologies = [
    "TypeScript",
    "NestJS",
    "Next.js",
    "PostgreSQL",
    "Docker",
];
---

<section class="hero" id="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

    <div class="container hero-container">
        <div class="hero-content">
            <div class="hero-eyebrow">
                <span class="status-dot"></span>
                <span>در حال ساخت محصولات نرم‌افزاری</span>
            </div>

            <h1>
                مهندس نرم‌افزار
                <span>Full-Stack</span>
            </h1>

            <p class="hero-lead">
                با تمرکز بر طراحی و توسعه سیستم‌های
                <strong> SaaS </strong>
                و
                <strong> Multi-Tenant</strong>
                ؛ از معماری و Backend تا Frontend، امنیت و زیرساخت.
            </p>

            <div class="hero-actions">
                <a
                    class="button button-primary hero-primary-button"
                    href="#projects"
                >
                    مشاهده پروژه‌ها

                    <svg
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                        focusable="false"
                    >
                        <path
                            d="M3 8h9M8 4l4 4-4 4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </a>

                <a class="button button-secondary" href="#contact">
                    ارتباط با من
                </a>
            </div>

            <div class="hero-tech">
                <span class="hero-tech-label">تمرکز فنی</span>

                <div class="tech-list">
                    {
                        technologies.map((technology) => (
                            <span>{technology}</span>
                        ))
                    }
                </div>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="visual-glow"></div>

            <div class="architecture-card">
                <div class="card-header">
                    <div class="window-controls">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <span class="card-label">system.architecture</span>
                </div>

                <div class="architecture">
                    <div class="architecture-node node-user">
                        <span class="node-icon">U</span>
                        <span>User</span>
                    </div>

                    <div class="connection connection-user"></div>

                    <div class="architecture-node node-api">
                        <span class="node-icon">API</span>
                        <span>Application</span>
                    </div>

                    <div class="connection connection-db"></div>

                    <div class="architecture-node node-db">
                        <span class="node-icon">DB</span>
                        <span>PostgreSQL</span>
                    </div>

                    <div class="architecture-node node-security">
                        <span class="node-icon">RLS</span>
                        <span>Isolation</span>
                    </div>

                    <div class="connection connection-security"></div>

                    <div class="architecture-node node-event">
                        <span class="node-icon">EV</span>
                        <span>Events</span>
                    </div>
                </div>

                <div class="card-footer">
                    <span class="live-indicator"></span>
                    <span>Systems built with intent.</span>
                </div>
            </div>

            <div class="floating-badge badge-tenant">
                <span class="badge-icon">T</span>
                <span>
                    <strong>Multi-Tenant</strong>
                    <small>Isolation by design</small>
                </span>
            </div>

            <div class="floating-badge badge-stack">
                <span class="badge-icon">{}</span>
                <span>
                    <strong>Full-Stack</strong>
                    <small>End-to-end development</small>
                </span>
            </div>
        </div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
        <span></span>
        <span>اسکرول کنید</span>
    </div>
</section>

<style>
    .hero {
        position: relative;

        display: flex;
        align-items: center;

        min-height: 100svh;
        padding-top: 8rem;
        padding-bottom: 5rem;

        overflow: hidden;
    }

    .hero-grid {
        position: absolute;
        inset: 0;

        background-image:
            linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.025) 1px,
                transparent 1px
            );

        background-size: 4rem 4rem;

        mask-image: radial-gradient(
            ellipse 75% 65% at 70% 45%,
            black,
            transparent 75%
        );

        opacity: 0.55;
        pointer-events: none;
    }

    .hero-orb {
        position: absolute;

        border-radius: 50%;

        pointer-events: none;

        filter: blur(1px);
    }

    .hero-orb-one {
        top: 15%;
        right: 25%;

        width: 24rem;
        height: 24rem;

        background: radial-gradient(
            circle,
            rgba(94, 230, 168, 0.07),
            transparent 68%
        );

        animation: orb-float-one 9s ease-in-out infinite;
    }

    .hero-orb-two {
        right: -10rem;
        bottom: -12rem;

        width: 30rem;
        height: 30rem;

        background: radial-gradient(
            circle,
            rgba(94, 230, 168, 0.045),
            transparent 70%
        );

        animation: orb-float-two 11s ease-in-out infinite;
    }

    .hero-container {
        position: relative;
        z-index: 1;

        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(25rem, 0.9fr);
        align-items: center;
        gap: clamp(3rem, 7vw, 8rem);
    }

    .hero-content {
        max-width: 42rem;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;

        margin-bottom: 1.75rem;
        padding: 0.45rem 0.7rem;

        background: rgba(94, 230, 168, 0.045);
        border: 1px solid rgba(94, 230, 168, 0.12);
        border-radius: 999px;

        color: var(--color-accent);

        font-size: 0.72rem;
        font-weight: 500;

        animation: hero-enter 700ms ease both;
    }

    .status-dot {
        width: 0.4rem;
        height: 0.4rem;

        background: var(--color-accent);
        border-radius: 50%;

        box-shadow: 0 0 0 4px rgba(94, 230, 168, 0.08);

        animation: status-pulse 2.5s ease-in-out infinite;
    }

    .hero h1 {
        max-width: 48rem;

        margin-bottom: 1.5rem;

        font-size: clamp(3.2rem, 7vw, 6.25rem);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.045em;

        animation: hero-enter 700ms 80ms ease both;
    }

    .hero h1 span {
        display: block;

        background: linear-gradient(
            110deg,
            var(--color-text) 10%,
            var(--color-accent) 85%
        );

        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
    }

    .hero-lead {
        max-width: 40rem;

        margin-bottom: 2rem;

        color: var(--color-text-secondary);

        font-size: clamp(1rem, 1.7vw, 1.2rem);
        line-height: 2;

        animation: hero-enter 700ms 160ms ease both;
    }

    .hero-lead strong {
        color: var(--color-text);
        font-weight: 600;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        margin-bottom: 3.5rem;

        animation: hero-enter 700ms 240ms ease both;
    }

    .hero-primary-button svg {
        width: 1rem;
        height: 1rem;

        transition: transform 180ms ease;
    }

    .hero-primary-button:hover svg {
        transform: translateX(-2px);
    }

    .hero-tech {
        display: flex;
        align-items: center;
        gap: 1rem;

        animation: hero-enter 700ms 320ms ease both;
    }

    .hero-tech-label {
        flex-shrink: 0;

        color: var(--color-text-muted);

        font-size: 0.7rem;
        font-weight: 500;
    }

    .tech-list {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .tech-list span {
        padding: 0.35rem 0.6rem;

        background: rgba(255, 255, 255, 0.025);
        border: 1px solid var(--color-border);
        border-radius: 0.45rem;

        color: var(--color-text-muted);

        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 500;

        transition:
            color 180ms ease,
            border-color 180ms ease,
            background-color 180ms ease;
    }

    .tech-list span:hover {
        background: var(--color-accent-soft);
        border-color: rgba(94, 230, 168, 0.2);
        color: var(--color-text);
    }

    /* Visual */

    .hero-visual {
        position: relative;

        display: flex;
        align-items: center;
        justify-content: center;

        min-height: 32rem;

        animation: visual-enter 900ms 180ms ease both;
    }

    .visual-glow {
        position: absolute;

        width: 25rem;
        height: 25rem;

        background: radial-gradient(
            circle,
            rgba(94, 230, 168, 0.09),
            transparent 68%
        );

        filter: blur(8px);
    }

    .architecture-card {
        position: relative;
        z-index: 2;

        width: min(100%, 29rem);

        padding: 1rem;

        background: linear-gradient(
            145deg,
            rgba(21, 28, 25, 0.94),
            rgba(12, 17, 15, 0.9)
        );

        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.25rem;

        box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.045);

        transform: perspective(1200px) rotateY(-4deg) rotateX(2deg);

        transition:
            transform 500ms ease,
            border-color 300ms ease;
    }

    .architecture-card:hover {
        transform: perspective(1200px) rotateY(0) rotateX(0) translateY(-4px);

        border-color: rgba(94, 230, 168, 0.2);
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0.25rem 0.25rem 1rem;

        border-bottom: 1px solid var(--color-border);
    }

    .window-controls {
        display: flex;
        gap: 0.3rem;
        direction: ltr;
    }

    .window-controls span {
        width: 0.42rem;
        height: 0.42rem;

        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
    }

    .card-label {
        color: var(--color-text-muted);

        font-family: monospace;
        font-size: 0.62rem;
        direction: ltr;
    }

    .architecture {
        position: relative;

        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, 5rem);

        gap: 0.75rem;

        padding: 1.5rem 0.5rem;
    }

    .architecture-node {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        gap: 0.55rem;

        padding: 0.65rem;

        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.075);
        border-radius: 0.7rem;

        color: var(--color-text-secondary);

        font-family: var(--font-sans);
        font-size: 0.62rem;

        transition:
            background-color 200ms ease,
            border-color 200ms ease,
            transform 200ms ease;
    }

    .architecture-node:hover {
        background: var(--color-accent-soft);
        border-color: rgba(94, 230, 168, 0.2);
        transform: translateY(-2px);
    }

    .node-icon {
        display: grid;
        place-items: center;

        flex-shrink: 0;

        width: 2rem;
        height: 2rem;

        background: rgba(94, 230, 168, 0.08);
        border: 1px solid rgba(94, 230, 168, 0.12);
        border-radius: 0.45rem;

        color: var(--color-accent);

        font-family: monospace;
        font-size: 0.55rem;
        font-weight: 600;
    }

    .node-user {
        grid-column: 1;
        grid-row: 1;
    }

    .node-api {
        grid-column: 2;
        grid-row: 1;
    }

    .node-db {
        grid-column: 1;
        grid-row: 2;
    }

    .node-security {
        grid-column: 2;
        grid-row: 2;
    }

    .node-event {
        grid-column: 1 / 3;
        grid-row: 3;
    }

    .connection {
        position: absolute;
        z-index: 1;

        background: rgba(94, 230, 168, 0.15);
    }

    .connection-user {
        top: 3.95rem;
        right: 50%;

        width: 1.5rem;
        height: 1px;
    }

    .connection-db {
        top: 8.75rem;
        right: 50%;

        width: 1.5rem;
        height: 1px;
    }

    .connection-security {
        top: 11.3rem;
        right: 50%;

        width: 1px;
        height: 1.2rem;
    }

    .card-footer {
        display: flex;
        align-items: center;
        gap: 0.45rem;

        padding: 0.85rem 0.25rem 0.2rem;

        border-top: 1px solid var(--color-border);

        color: var(--color-text-muted);

        font-family: monospace;
        font-size: 0.58rem;
        direction: ltr;
    }

    .live-indicator {
        width: 0.35rem;
        height: 0.35rem;

        background: var(--color-accent);
        border-radius: 50%;

        box-shadow: 0 0 10px rgba(94, 230, 168, 0.45);
    }

    .floating-badge {
        position: absolute;
        z-index: 3;

        display: flex;
        align-items: center;
        gap: 0.65rem;

        padding: 0.65rem 0.8rem;

        background: rgba(17, 23, 21, 0.86);
        border: 1px solid var(--color-border);
        border-radius: 0.8rem;

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);

        direction: ltr;
    }

    .badge-tenant {
        top: 13%;
        right: -2%;

        animation: badge-float-one 5s ease-in-out infinite;
    }

    .badge-stack {
        bottom: 14%;
        left: -5%;

        animation: badge-float-two 6s ease-in-out infinite;
    }

    .badge-icon {
        display: grid;
        place-items: center;

        width: 2rem;
        height: 2rem;

        background: var(--color-accent-soft);
        border: 1px solid rgba(94, 230, 168, 0.15);
        border-radius: 0.5rem;

        color: var(--color-accent);

        font-family: monospace;
        font-size: 0.58rem;
        font-weight: 600;
    }

    .floating-badge span:last-child {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .floating-badge strong {
        color: var(--color-text);

        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 600;
    }

    .floating-badge small {
        color: var(--color-text-muted);

        font-family: var(--font-sans);
        font-size: 0.52rem;
    }

    .hero-scroll {
        position: absolute;
        right: 50%;
        bottom: 1.5rem;

        display: flex;
        align-items: center;
        gap: 0.55rem;

        color: var(--color-text-muted);

        font-size: 0.62rem;

        transform: translateX(50%);
    }

    .hero-scroll span:first-child {
        width: 1px;
        height: 1.75rem;

        background: linear-gradient(
            to bottom,
            var(--color-accent),
            transparent
        );

        animation: scroll-line 2s ease-in-out infinite;
    }

    /* Animations */

    @keyframes hero-enter {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes visual-enter {
        from {
            opacity: 0;
            transform: translateY(1.5rem) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes status-pulse {
        0%,
        100% {
            box-shadow: 0 0 0 4px rgba(94, 230, 168, 0.08);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(94, 230, 168, 0.025);
        }
    }

    @keyframes badge-float-one {
        0%,
        100% {
            transform: translateY(0) rotate(1deg);
        }

        50% {
            transform: translateY(-0.5rem) rotate(-1deg);
        }
    }

    @keyframes badge-float-two {
        0%,
        100% {
            transform: translateY(0) rotate(-1deg);
        }

        50% {
            transform: translateY(0.45rem) rotate(1deg);
        }
    }

    @keyframes orb-float-one {
        0%,
        100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(-1.5rem, 1rem);
        }
    }

    @keyframes orb-float-two {
        0%,
        100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(1rem, -1.5rem);
        }
    }

    @keyframes scroll-line {
        0%,
        100% {
            opacity: 0.35;
            transform: scaleY(0.65);
            transform-origin: top;
        }

        50% {
            opacity: 1;
            transform: scaleY(1);
            transform-origin: top;
        }
    }

    @media (max-width: 1100px) {
        .hero-container {
            grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.8fr);
            gap: 3rem;
        }

        .badge-tenant {
            right: -4%;
        }

        .badge-stack {
            left: -8%;
        }
    }

    @media (max-width: 900px) {
        .hero {
            padding-top: 8rem;
            padding-bottom: 6rem;
        }

        .hero-container {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .hero-content {
            max-width: 45rem;
            margin-inline: auto;
            text-align: center;
        }

        .hero-eyebrow {
            margin-inline: auto;
        }

        .hero-lead {
            margin-inline: auto;
        }

        .hero-actions {
            justify-content: center;
        }

        .hero-tech {
            justify-content: center;
        }

        .hero-visual {
            min-height: 28rem;
        }

        .hero-scroll {
            display: none;
        }
    }

    @media (max-width: 600px) {
        .hero {
            min-height: auto;
            padding-top: 7.5rem;
            padding-bottom: 4rem;
        }

        .hero h1 {
            font-size: clamp(2.75rem, 13vw, 4rem);
            letter-spacing: -0.035em;
        }

        .hero-lead {
            font-size: 0.95rem;
            line-height: 1.9;
        }

        .hero-actions {
            flex-direction: column;
            align-items: stretch;
            margin-bottom: 2.5rem;
        }

        .hero-actions .button {
            width: 100%;
        }

        .hero-tech {
            flex-direction: column;
            gap: 0.75rem;
        }

        .hero-visual {
            min-height: 22rem;
        }

        .architecture-card {
            width: 100%;
            transform: none;
        }

        .architecture-card:hover {
            transform: translateY(-2px);
        }

        .floating-badge {
            display: none;
        }

        .architecture {
            grid-template-rows: repeat(3, 4.5rem);
        }

        .architecture-node {
            font-size: 0.56rem;
        }

        .node-icon {
            width: 1.75rem;
            height: 1.75rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-orb-one,
        .hero-orb-two,
        .status-dot,
        .floating-badge,
        .hero-scroll span:first-child {
            animation: none;
        }

        .hero-content,
        .hero-visual {
            animation: none;
        }
    }
</style>
